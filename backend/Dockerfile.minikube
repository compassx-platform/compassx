FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/ms-home

WORKDIR /ms-home

COPY requirements-minikube.txt ./
RUN pip install --no-cache-dir -r requirements-minikube.txt

COPY . .

CMD ["/bin/sh", "-c", "\
  set -euo pipefail; \
  if [ -f /var/secrets/env ]; then \
    set -a; source /var/secrets/env; set +a; \
  fi; \
  exec python app.py \
"]
