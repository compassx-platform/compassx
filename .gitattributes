# Auto-detect text files and normalize line endings
* text=auto

# Enforce LF for POSIX shell scripts, Dockerfiles, and YAML configurations
*.sh text eol=lf
compassx text eol=lf
Dockerfile* text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf

# Enforce CRLF for Windows batch and powershell scripts
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf
