# ==========================================
# Core Database Settings (Required)
# ==========================================
PG_HOST=localhost
PG_PORT=5433
PG_USER=postgres
PG_PASSWORD=postgres

# ==========================================
# Security & Encryption Secrets
# ==========================================
JWT_SECRET=dev-jwt-secret-change-me-for-production-use-min-32-chars
SECRET_KEY=dev-secret-key-for-credentials-encryption
CATALOG_ENCRYPTION_KEY=

# ==========================================
# Platform Services (Local-Dev Defaults)
# ==========================================
REDIS_URL=redis://localhost:6379/0
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
AIRFLOW_CALLBACK_SECRET=compassx-local-dev-secret

# ==========================================
# Managed Storage (Account / Deployment Default)
# Supported: minio | s3 | azure | local
# ==========================================
STORAGE_BACKEND=minio
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=compassx
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_REGION=us-east-1
STORAGE_PREFIX=
